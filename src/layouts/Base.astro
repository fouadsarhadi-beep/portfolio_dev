---
/** @module layouts/Base: html head, fonts, global styles, meta, JSON-LD, skip link. @see src/pages/index.astro, src/styles/base.css */
import '@fontsource-variable/fredoka';
import '@fontsource-variable/dm-sans';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/hud.css';
import '@/styles/sections.css';
import { SITE } from '@/config/site';
import { LAYERS } from '@/config/layers';
import { t } from '@/lib/i18n';

interface Props { title: string; description?: string }

const { title, description } = Astro.props;
const desc = description ?? `${SITE.role}: ${LAYERS.map((l) => l.title).join(', ')}.`;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.role,
  email: `mailto:${SITE.email}`,
  knowsAbout: LAYERS.map((l) => l.title),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline>
      // Theme before first paint: saved choice wins, else system preference.
      try {
        var saved = localStorage.getItem('theme');
        var t = saved === 'dark' || saved === 'light'
          ? saved
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = t;
      } catch (e) {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skipToContent')}</a>
    <slot />
  </body>
</html>
