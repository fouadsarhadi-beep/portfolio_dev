---
/** @module pages/404: not found: the six floors as an exit. @see src/layouts/Base.astro, src/config/layers.ts */
import Base from '@/layouts/Base.astro';
import { LAYERS } from '@/config/layers';
import { t } from '@/lib/i18n';
---

<Base title={`${t('nf.title')} | ${t('nf.home')}`}>
  <main id="main" class="shell nf">
    <p class="nf-kicker">404</p>
    <h1 data-t="nf.title">{t('nf.title')}</h1>
    <p class="nf-line" data-t="nf.line">{t('nf.line')}</p>
    <ul class="nf-list">
      {LAYERS.map((l) => (
        <li style={`--layer-c: var(--c-${l.color})`} data-layer-id={l.id}>
          <a href={`/work/${l.id}/`}>
            <span class="nf-num">{l.number}</span>
            <span class="nf-title" data-lf="title">{l.title}</span>
          </a>
        </li>
      ))}
    </ul>
    <a class="btn" href="/" data-t="nf.home">{t('nf.home')}</a>
  </main>
</Base>

<style>
  .nf {
    padding-block: clamp(64px, 14vh, 140px) 96px;
  }

  .nf-kicker {
    font-size: var(--fs-12);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    color: var(--ink-soft);
  }

  .nf h1 {
    margin-block-start: 10px;
    font-size: clamp(var(--fs-28), 5vw, var(--fs-44));
  }

  .nf-line {
    margin-block-start: 10px;
    color: var(--ink-soft);
  }

  .nf-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
    gap: 10px;
    margin-block: 28px;
  }

  .nf-list li {
    min-inline-size: 0;
  }

  .nf-list a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 12px 16px;
    background: var(--surface-grad);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--edge-highlight), var(--shadow-card);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }

  .nf-list a:hover {
    border-color: color-mix(in srgb, var(--layer-c, var(--ink)) 55%, var(--line));
    transform: translateY(-2px);
  }

  .nf-num {
    font-size: var(--fs-12);
    font-weight: 700;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .nf-title {
    font-family: var(--font-display);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    overflow-wrap: anywhere;
  }
</style>