---
/** @module pages/index: the one-page experience, sections in order. @see src/layouts/Base.astro, src/sections/*.astro */
import Base from '@/layouts/Base.astro';
import Hud from '@/sections/Hud.astro';
import Ladder from '@/sections/Ladder.astro';
import Hero from '@/sections/Hero.astro';
import About from '@/sections/About.astro';
import Contact from '@/sections/Contact.astro';
import Footer from '@/sections/Footer.astro';
import { SITE } from '@/config/site';
---

<Base title={`${SITE.name} — ${SITE.role}`}>
  <Hud />
  <Ladder />
  <main id="main">
    <Hero />
    <About />
    <Contact />
  </main>
  <Footer />
</Base>

<script>
  import '@/main';
</script>
