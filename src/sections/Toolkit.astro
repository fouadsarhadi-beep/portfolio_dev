---
/** @module sections/Toolkit: six tiles, one per layer, with tool chips. @see docs/DESIGN.md (Sections), src/config/layers.ts */
import { LAYERS } from '@/config/layers';
import { t } from '@/lib/i18n';
---

<section id="toolkit" class="toolkit wrap">
  <h2 class="section-head">{t('toolkit.heading')}</h2>
  <p class="section-intro">{t('toolkit.intro')}</p>
  <div class="tiles">
    {LAYERS.map((l) => (
      <article class="tile" style={`--layer-c: var(--c-${l.color})`}>
        <div class="tile-head">
          <span class="tile-num" aria-hidden="true">{l.number}</span>
          <h3>{l.title}</h3>
          <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={l.icon} /></svg>
        </div>
        <ul class="chips">
          {l.toolkit.map((tool) => (
            <li class="chip">{tool}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
