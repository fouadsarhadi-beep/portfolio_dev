---
/** @module sections/Hero: tall scroll stage, sticky canvas mount, layer nav, hero copy, no-JS fallback. @see docs/MOTION.md, src/styles/hud.css, src/styles/sections.css */
import { LAYERS } from '@/config/layers';
import { t } from '@/lib/i18n';
---

<script>
  import { bus } from '@/lib/bus';
  import { LAYERS } from '@/config/layers';

  const count = document.querySelector<HTMLElement>('[data-guide-count]');
  const title = document.querySelector<HTMLElement>('[data-guide-title]');
  const short = document.querySelector<HTMLElement>('[data-guide-short]');

  // The right guide names the floor the scroll is on: it is the caption for the
  // tower, and the reason the empty space either side of it earns its keep.
  bus.on('step:change', ({ step }) => {
    const layer = LAYERS[Math.min(step, LAYERS.length - 1)];
    if (!layer) return;
    if (count) count.textContent = layer.number;
    if (title) title.textContent = layer.title;
    if (short) short.textContent = layer.short;
  });

  // If three.js has not mounted anything shortly after load, mark the mount so a
  // quiet placeholder shows: on a slow line the stage must not look broken.
  const mount = document.getElementById('canvas-mount');
  if (mount) {
    window.setTimeout(() => {
      const live = mount.getAttribute('data-live') === 'true' || mount.childElementCount > 0;
      if (!live && !document.documentElement.classList.contains('no-webgl')) {
        mount.dataset.pending = 'true';
      }
    }, 2200);
  }
</script>

<section id="stack" class="stage">
  <div class="stage-sticky">
    <div id="canvas-mount"></div>
    <ul class="layer-nav">
      {LAYERS.map((l) => (
        <li>
          <button
            type="button"
            data-layer-id={l.id}
            style={`--layer-c: var(--c-${l.color})`}
            aria-label={`${t('a11y.openLayer')} ${l.number}: ${l.title}`}
          >
            <span class="ln-num" aria-hidden="true">{l.number}</span>
            <span class="ln-title">{l.title}</span>
          </button>
        </li>
      ))}
    </ul>
    <div class="hero-copy">
      <h1>{t('hero.h1')}</h1>
      <p class="sub">{t('hero.sub')}</p>
      <p class="hint">{t('hero.hint')}</p>
    </div>
    <aside class="stage-guide stage-guide--left">
      <p class="sg-kicker"><span class="sg-dot" aria-hidden="true"></span>{t('guide.kicker')}</p>
      <p class="sg-line">{t('guide.line')}</p>
      <p class="sg-hint"><span class="sg-arrow" aria-hidden="true">&#8594;</span>{t('guide.hint')}</p>
      <p class="sg-skip"><a href="#about">{t('guide.skip')}</a></p>
    </aside>
    <aside class="stage-guide stage-guide--right">
      <p class="sg-count"><span data-guide-count>{LAYERS[0].number}</span><span class="sg-of">/ {String(LAYERS.length).padStart(2, '0')}</span></p>
      <p class="sg-title" data-guide-title>{LAYERS[0].title}</p>
      <p class="sg-short" data-guide-short>{LAYERS[0].short}</p>
    </aside>
  </div>
  <div class="stack-fallback">
    {LAYERS.map((l) => (
      <article style={`--layer-c: var(--c-${l.color})`}>
        <p class="sf-num">{l.number}</p>
        <h2>{l.title}</h2>
        <p>{l.short}</p>
        <a class="btn" href={`/work/${l.id}/`}>{t('preview.viewWork')}</a>
      </article>
    ))}
  </div>
</section>
