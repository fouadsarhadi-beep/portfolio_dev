---
/** @module sections/Footer: compact footer with name, note, top link. @see docs/DESIGN.md (Sections) */
import { SITE } from '@/config/site';
import { t } from '@/lib/i18n';
---

<footer class="footer">
  <div class="footer-row">
    <p><strong>{SITE.name}</strong> · {SITE.role}</p>
    <p>{t('footer.note')}</p>
    <a href="#stack">{t('nav.stack')}</a>
  </div>
</footer>
