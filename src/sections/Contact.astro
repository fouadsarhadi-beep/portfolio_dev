---
/** @module sections/Contact: end-of-level panel with heading, mailto, socials, availability. @see docs/COPY.md, src/config/site.ts */
import { SITE } from '@/config/site';
import { t } from '@/lib/i18n';
---

<section id="contact" class="contact shell">
  <div class="contact-panel" style="--layer-c: var(--c-butter)">
    <h2>{t('contact.heading')}</h2>
    <p>{t('contact.body')}</p>
    <p class="avail" data-available={String(SITE.available)}>
      <span class="dot" aria-hidden="true"></span>
      {t('contact.availability')}
    </p>
    <div class="contact-actions">
      <a class="btn" href={`mailto:${SITE.email}`}>{t('contact.emailButton')}</a>
      <button type="button" class="btn btn-ghost" data-copy-email={SITE.email}>{t('contact.copyEmail')}</button>
    </div>
    <ul class="socials">
      {SITE.socials.map((s) => (
        <li><a href={s.href}>{s.label}</a></li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { t } from '@/lib/i18n';

  // Copy the address for people whose machine has no mail client wired up.
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  if (button) {
    const label = button.textContent ?? '';
    button.addEventListener('click', () => {
      const email = button.dataset.copyEmail ?? '';
      navigator.clipboard?.writeText(email).then(
        () => {
          button.textContent = t('contact.copied');
          button.dataset.copied = 'true';
          window.setTimeout(() => {
            button.textContent = label;
            delete button.dataset.copied;
          }, 1600);
        },
        () => {
          /* clipboard blocked: the mailto button still works */
        },
      );
    });
  }
</script>
